FROM ros:noetic-ros-base-focal

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=noetic \
    Torch_DIR=/opt/libtorch/share/cmake/Torch \
    LD_LIBRARY_PATH=/opt/libtorch/lib

# Use USTC mirrors for Ubuntu, ROS 1, and pip packages.
RUN printf '%s\n' \
    'deb https://mirrors.ustc.edu.cn/ubuntu/ focal main restricted universe multiverse' \
    'deb https://mirrors.ustc.edu.cn/ubuntu/ focal-updates main restricted universe multiverse' \
    'deb https://mirrors.ustc.edu.cn/ubuntu/ focal-security main restricted universe multiverse' \
    > /etc/apt/sources.list \
    && printf '%s\n' \
    'deb [trusted=yes] https://mirrors.ustc.edu.cn/ros/ubuntu focal main' \
    > /etc/apt/sources.list.d/ros1.list \
    && printf '%s\n' \
    '[global]' \
    'index-url = https://mirrors.ustc.edu.cn/pypi/web/simple' \
    'trusted-host = mirrors.ustc.edu.cn' \
    > /etc/pip.conf

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip wget git build-essential cmake ninja-build pkg-config \
    python3-pip python3-venv python3-catkin-pkg python3-empy python3-rosdep \
    ros-noetic-grid-map-core \
    ros-noetic-grid-map-ros \
    ros-noetic-grid-map-visualization \
    ros-noetic-pcl-ros \
    ros-noetic-pcl-conversions \
    ros-noetic-tf2-ros \
    ros-noetic-tf2-eigen \
    ros-noetic-tf2-geometry-msgs \
    ros-noetic-velodyne-pointcloud \
    ros-noetic-nodelet \
    ros-noetic-rviz \
    && rm -rf /var/lib/apt/lists/*

# ROS Noetic's Ubuntu 20.04 image does not contain the CUDA development
# toolkit.  CUDA-enabled LibTorch needs nvcc, headers, and CMake's CUDA
# libraries while configuring the ROS package.
RUN curl -fL --retry 5 --connect-timeout 30 \
       -o /tmp/cuda-keyring.deb \
       https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i /tmp/cuda-keyring.deb \
    && rm /tmp/cuda-keyring.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends cuda-toolkit-12-9 \
    && ln -sfn /usr/local/cuda-12.9 /usr/local/cuda \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/catkin-venv \
    && /opt/catkin-venv/bin/pip install --no-cache-dir \
    -i https://mirrors.ustc.edu.cn/pypi/web/simple \
    --no-deps catkin-tools osrf-pycommon

ENV PATH=/opt/catkin-venv/bin:${PATH}
ENV CUDA_HOME=/usr/local/cuda-12.9 \
    CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda-12.9 \
    CUDAToolkit_ROOT=/usr/local/cuda-12.9 \
    PATH=/usr/local/cuda-12.9/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda-12.9/lib64:/opt/libtorch/lib

# CUDA-enabled LibTorch is kept in the build context so rebuilding the image
# does not download the multi-gigabyte archive again.
COPY docker/libtorch-shared-with-deps-2.8.0+cu129.zip /tmp/libtorch.zip

RUN mkdir -p /opt \
    && unzip -q /tmp/libtorch.zip -d /opt \
    && rm /tmp/libtorch.zip

WORKDIR /workspace/ros_ws
COPY height_mapping/height_mapping_core /workspace/ros_ws/src/height_mapping_core
COPY lesta_ros /workspace/ros_ws/src/lesta
COPY data_preprocessing/ros1 /workspace/data_preprocessing/ros1

RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && catkin init \
    && catkin config --extend /opt/ros/${ROS_DISTRO} \
    && catkin config --merge-devel \
    && catkin config --cmake-args \
       -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_PREFIX_PATH=/workspace/ros_ws/devel\;/opt/ros/noetic \
       -DTorch_DIR=/opt/libtorch/share/cmake/Torch \
       -DCUDA_TOOLKIT_ROOT_DIR=${CUDA_TOOLKIT_ROOT_DIR} \
       -DCUDAToolkit_ROOT=${CUDAToolkit_ROOT} \
    && catkin build height_mapping_core \
    && source /workspace/ros_ws/devel/setup.bash \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && catkin build lesta

RUN echo 'source /opt/ros/noetic/setup.bash' >> /root/.bashrc \
    && echo 'source /workspace/ros_ws/devel/setup.bash' >> /root/.bashrc

CMD ["/bin/bash"]
